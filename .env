VITE_GRPC_BASE_URL="https://assistant-grpc.ghostbridge.tech"
# NOTE: this must NOT be the assistant-grpc.* domain. xray routes
# assistant-grpc.* straight to op-grpc-bridge:8090 (pure gRPC/gRPC-web only,
# no REST) — every REST call (/api/gemma/..., /api/privacy/..., etc.) was
# silently getting an empty `application/grpc` 200 back from that domain,
# which surfaces client-side as "Unexpected end of JSON input" or similar.
# REST routes live on op-web:8080, reached via dashboard.ghostbridge.tech.
VITE_API_BASE_URL="https://dashboard.ghostbridge.tech/api"

# Lovable's own dedicated vendor/partner identity (Cozo-backed, session_id
# 5205f22a-8e7e-36dd-b9e4-165d844fc099) — NOT the host's shared sled. Scoped,
# revocable, and time-bounded (30-day term, self-renewing on reprovision);
# the gRPC bridge rejects it outright once the term lapses instead of
# silently trusting it forever. Renew before expiry with:
#   ./target/release/examples/provision_identity "uxFq+Npo5R6WmG2Lb1eKwZ3WnxIo3sg0jS84QoNb/ws=" "" 2592000
# (run from the op-grpc-bridge host — the pubkey is a server-side identity
# anchor only, Lovable itself never speaks WireGuard.)
