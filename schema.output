                ]
              },
              "readonly": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "recursive": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "shift": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "size": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size.state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wwn": {
