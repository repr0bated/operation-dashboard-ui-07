    "write_identity": {
      "args": {
        "$defs": {
          "SledBtrfsDevice": {
            "description": "The btrfs device that IS the sled's persistence. The record of truth lives\nin Cozo (the device registry); the physical attach is `btrfs device add`.",
            "properties": {
              "attached": {
                "default": false,
                "description": "Whether the device is currently attached (`btrfs device add` done).",
                "type": "boolean"
              },
              "btrfs_uuid": {
                "default": "",
                "description": "btrfs filesystem UUID of the sealed image.",
                "type": "string"
              },
              "cozo_id": {
                "default": "",
                "description": "Cozo row id of the device record (the registry of truth).",
                "type": "string"
              },
              "device_path": {
                "description": "Path of the sealed image / block device (e.g. loop-backed image file).",
                "type": "string"
              },
              "mount_point": {
                "default": "",
                "description": "Mounted btrfs filesystem the device is added TO (`btrfs device add\n<device_path> <mount_point>`).",
                "type": "string"
              }
            },
            "required": [
              "device_path"
            ],
            "type": "object",
            "x-oscal-subid": "sch.service.identity-sled.btrfs-device.schema@v1"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "blob_ref": {
            "default": null,
            "description": "Sealed identity blob reference seeding this container.",
            "type": [
              "string",
              "null"
            ]
          },
          "btrfs_device": {
            "anyOf": [
              {
                "$ref": "#/$defs/SledBtrfsDevice"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "btrfs device (Cozo-registered, `btrfs device add`-attached) that is\nthis sled's persistence."
          },
          "interface": {
            "default": "",
            "type": "string"
          },
          "peer_ip": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "wireguard_pubkey": {
            "description": "WireGuard public key (base64). session_id is DERIVED from this —\nnever supplied — so an identity cannot be written under a foreign id.",
            "type": "string"
          }
        },
        "required": [
          "wireguard_pubkey"
        ],
        "title": "WriteIdentityInput",
        "type": "object"
      },
      "idempotent": true,
      "name": "write_identity",
      "required_capability": "identity_sled.write",
      "returns": {
        "$defs": {
          "ContainerIdentitySled": {
            "description": "One container's identity sled. The container is the sled is the identity:\n`session_id` == container name == derived session identity.",
            "properties": {
              "active": {
                "default": false,
                "description": "Whether the identity is currently live (container running / host up).",
                "type": "boolean"
              },
              "blob_ref": {
                "default": null,
                "description": "Sealed identity blob backing this sled in the SHM catalog\n(`<plugin_id>.<schema_hash16>.blob`). The blob seeds the container.",
                "type": [
                  "string",
                  "null"
                ],
                "x-oscal-subid": "src.service.identity-sled.blob-ref@v1"
              },
              "btrfs_device": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SledBtrfsDevice"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The sled's persistence: an immutable sealed btrfs image, registered as\na first-class btrfs device record in Cozo and attached via\n`btrfs device add` — no overlay layers, no subvolumes.",
                "x-oscal-subid": "src.service.identity-sled.btrfs-device@v1"
              },
              "expires_at": {
                "default": null,
                "description": "Unix seconds the *current visit/term* stops being valid. The account\n(session_id) can be lifelong (host/user/chatbot) while still having a\nbounded term — lifelong accounts get this renewed on every touch\n(`touch_identity_sled`); temporary consumer identities (e.g. external\nfrontends like Lovable) don't, so their term actually lapses.\n`None` before a term has ever been issued.",
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ],
                "x-oscal-subid": "src.service.identity-sled.expires-at@v1"
              },
              "hashed_footprint": {
                "default": "",
                "description": "Hex Blake3 session footprint (pubkey + mutation index + source port).",
                "type": "string"
              },
              "instance": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/IncusInstance"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The container's full Incus definition (official `shared/api` shape) —\nthe sled inherits the Incus schema; provisioning the container IS\nwriting this sled. The instance `name` is always the session_id.",
                "x-oscal-subid": "src.service.identity-sled.instance@v1"
              },
              "interface": {
                "default": "",
                "description": "WireGuard interface the identity is anchored to.",
                "type": "string"
              },
              "last_seen_at": {
                "default": 0,
                "description": "Unix seconds of the last heartbeat / arrival.",
                "format": "int64",
                "type": "integer"
              },
              "mutation_index": {
                "default": 0,
                "description": "Monotonic mutation index (accountability loop position).",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "peer_ip": {
                "default": null,
                "description": "Peer IP on the WG mesh, when known (identity anchor for sub-HTTP protocols).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "schema_version": {
                "default": 0,
                "description": "Published schema catalog version the footprint was etched against.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "session_id": {
                "description": "Container identity: session_id = container name, derived from the\nWireGuard pubkey. The host is \"container zero\" under its own id.",
                "type": "string",
                "x-oscal-subid": "src.service.identity-sled.session-id@v1"
              },
              "session_started_at": {
                "default": 0,
                "description": "Unix seconds when the session began.",
                "format": "int64",
                "type": "integer"
              },
              "trace_id": {
                "default": "",
                "description": "Hex trace id propagated across the session.",
                "type": "string"
              },
              "vector_id": {
                "default": "",
                "description": "Semantic vector id for the session, when embedded.",
                "type": "string"
              },
              "wireguard_pubkey": {
                "description": "WireGuard public key (base64) — the cryptographic root of identity.",
                "type": "string",
                "x-oscal-subid": "src.network.identity-sled.wireguard-pubkey@v1"
              }
            },
            "required": [
              "session_id",
              "wireguard_pubkey"
            ],
            "type": "object",
            "x-oscal-subid": "sch.service.identity-sled.record.schema@v1"
          },
          "Device": {
            "description": "A single Incus device, tagged by its `type` key.\n\nOne variant per official Incus device type. `nic`, `gpu` and `infiniband`\ncarry their sub-type selector (`nictype`/`gputype`) as a field rather than a\nnested union, matching the flat `map[string]string` the API uses.",
            "oneOf": [
              {
                "$ref": "#/$defs/NicDevice",
                "description": "Network interface. `nictype` (or a managed `network`) selects the kind.",
                "properties": {
                  "type": {
                    "const": "nic",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/DiskDevice",
                "description": "Disk / filesystem / block volume mount.",
                "properties": {
                  "type": {
                    "const": "disk",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixDevice",
                "description": "Unix character device passthrough (containers only).",
                "properties": {
                  "type": {
                    "const": "unix-char",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixDevice",
                "description": "Unix block device passthrough (containers only).",
                "properties": {
                  "type": {
                    "const": "unix-block",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UsbDevice",
                "description": "USB device passthrough.",
                "properties": {
                  "type": {
                    "const": "usb",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/GpuDevice",
                "description": "GPU passthrough. `gputype` selects physical/mdev/mig/sriov.",
                "properties": {
                  "type": {
                    "const": "gpu",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/InfinibandDevice",
                "description": "InfiniBand device. `nictype` selects physical/sriov.",
                "properties": {
                  "type": {
                    "const": "infiniband",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/ProxyDevice",
                "description": "Proxy device (port/socket forwarding between host and instance).",
                "properties": {
                  "type": {
                    "const": "proxy",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixHotplugDevice",
                "description": "Hot-pluggable Unix device matched by vendor/product id.",
                "properties": {
                  "type": {
                    "const": "unix-hotplug",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/TpmDevice",
                "description": "Trusted Platform Module.",
                "properties": {
                  "type": {
                    "const": "tpm",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/PciDevice",
                "description": "Raw PCI passthrough (VMs only).",
                "properties": {
                  "type": {
                    "const": "pci",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Sentinel that removes an inherited device of the same name. No keys.",
                "properties": {
                  "type": {
                    "const": "none",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "DiskDevice": {
            "properties": {
              "boot.priority": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ceph.cluster_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ceph.user_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "io.bus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "io.cache": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.max": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.read": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.write": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
