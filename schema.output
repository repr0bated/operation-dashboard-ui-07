          },
          "ProxyDevice": {
            "properties": {
              "bind": {
                "description": "`host` (default) or `instance`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "connect": {
                "description": "Required. Target the proxy connects to, e.g. `tcp:127.0.0.1:50051`.",
                "type": "string"
              },
              "gid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "listen": {
                "description": "Required. Address the proxy listens on, e.g. `unix:/run/assistant.sock`.",
                "type": "string"
              },
              "mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
