                  "integer",
                  "null"
                ]
              },
              "connected": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "gvrp": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "host_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hwaddr": {
