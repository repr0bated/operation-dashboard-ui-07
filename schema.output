                  "type": {
                    "const": "pci",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Sentinel that removes an inherited device of the same name. No keys.",
                "properties": {
                  "type": {
                    "const": "none",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
