                ]
              },
              "connect": {
                "description": "Required. Target the proxy connects to, e.g. `tcp:127.0.0.1:50051`.",
                "type": "string"
              },
              "gid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
