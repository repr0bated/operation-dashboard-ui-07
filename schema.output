{
  "category": "uncategorized",
  "dependencies": [],
  "description": "Container identity sleds: the container is the sled is the identity; host is container zero; each record is seeded by its sealed blob",
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "example": null,
  "fields": {
    "sleds": {
      "constraints": [],
      "default": null,
      "description": "All known container identity sleds, keyed by `session_id`, sorted.",
      "example": null,
      "field_type": {
        "array": {
          "object": {
            "active": {
              "constraints": [],
              "default": false,
              "description": "Whether the identity is currently live (container running / host up).",
              "example": null,
              "field_type": "boolean",
              "read_only": false,
              "read_only_when": null,
              "required": false
            },
            "blob_ref": {
              "constraints": [],
              "default": null,
              "description": "Sealed identity blob backing this sled in the SHM catalog\n(`<plugin_id>.<schema_hash16>.blob`). The blob seeds the container.",
              "example": null,
              "field_type": "string",
              "read_only": false,
              "read_only_when": null,
              "required": false
            },
            "btrfs_device": {
              "constraints": [],
              "default": null,
              "description": "The sled's persistence: an immutable sealed btrfs image, registered as\na first-class btrfs device record in Cozo and attached via\n`btrfs device add` — no overlay layers, no subvolumes.",
              "example": null,
              "field_type": {
                "object": {
                  "attached": {
                    "constraints": [],
                    "default": false,
                    "description": "Whether the device is currently attached (`btrfs device add` done).",
                    "example": null,
                    "field_type": "boolean",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "btrfs_uuid": {
                    "constraints": [],
                    "default": "",
                    "description": "btrfs filesystem UUID of the sealed image.",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "cozo_id": {
                    "constraints": [],
                    "default": "",
                    "description": "Cozo row id of the device record (the registry of truth).",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "device_path": {
                    "constraints": [],
                    "default": null,
                    "description": "Path of the sealed image / block device (e.g. loop-backed image file).",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": true
                  },
                  "mount_point": {
                    "constraints": [],
                    "default": "",
                    "description": "Mounted btrfs filesystem the device is added TO (`btrfs device add\n<device_path> <mount_point>`).",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  }
                }
              },
              "read_only": false,
              "read_only_when": null,
              "required": false
            },
            "expires_at": {
              "constraints": [],
              "default": null,
              "description": "Unix seconds the *current visit/term* stops being valid. The account\n(session_id) can be lifelong (host/user/chatbot) while still having a\nbounded term — lifelong accounts get this renewed on every touch\n(`touch_identity_sled`); temporary consumer identities (e.g. external\nfrontends like Lovable) don't, so their term actually lapses.\n`None` before a term has ever been issued.",
              "example": null,
              "field_type": "integer",
              "read_only": false,
              "read_only_when": null,
              "required": false
            },
            "hashed_footprint": {
              "constraints": [],
              "default": "",
              "description": "Hex Blake3 session footprint (pubkey + mutation index + source port).",
              "example": null,
              "field_type": "string",
              "read_only": false,
              "read_only_when": null,
              "required": false
            },
            "instance": {
              "constraints": [],
              "default": null,
              "description": "The container's full Incus definition (official `shared/api` shape) —\nthe sled inherits the Incus schema; provisioning the container IS\nwriting this sled. The instance `name` is always the session_id.",
              "example": null,
              "field_type": {
                "object": {
                  "architecture": {
                    "constraints": [],
                    "default": null,
                    "description": "CPU architecture (e.g. \"x86_64\")",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "config": {
                    "constraints": [],
                    "default": null,
                    "description": "Instance configuration key-value pairs (`InstancePut.config`).",
                    "example": null,
                    "field_type": {
                      "object": {}
                    },
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "created_at": {
                    "constraints": [],
                    "default": null,
                    "description": "Creation timestamp (ISO8601)",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "description": {
                    "constraints": [],
                    "default": null,
                    "description": "Human-readable description",
                    "example": null,
                    "field_type": "string",
                    "read_only": false,
                    "read_only_when": null,
                    "required": false
                  },
                  "devices": {
                    "constraints": [],
                    "default": null,
