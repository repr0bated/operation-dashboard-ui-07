                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UsbDevice",
                "description": "USB device passthrough.",
                "properties": {
                  "type": {
                    "const": "usb",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/GpuDevice",
                "description": "GPU passthrough. `gputype` selects physical/mdev/mig/sriov.",
                "properties": {
