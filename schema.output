                "type": [
                  "integer",
                  "null"
                ]
              },
              "uid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "connect",
              "listen"
            ],
            "type": "object"
          },
          "SledBtrfsDevice": {
            "description": "The btrfs device that IS the sled's persistence. The record of truth lives\nin Cozo (the device registry); the physical attach is `btrfs device add`.",
            "properties": {
              "attached": {
                "default": false,
                "description": "Whether the device is currently attached (`btrfs device add` done).",
                "type": "boolean"
              },
              "btrfs_uuid": {
                "default": "",
                "description": "btrfs filesystem UUID of the sealed image.",
                "type": "string"
              },
              "cozo_id": {
                "default": "",
                "description": "Cozo row id of the device record (the registry of truth).",
                "type": "string"
              },
              "device_path": {
                "description": "Path of the sealed image / block device (e.g. loop-backed image file).",
                "type": "string"
              },
              "mount_point": {
                "default": "",
                "description": "Mounted btrfs filesystem the device is added TO (`btrfs device add\n<device_path> <mount_point>`).",
                "type": "string"
              }
            },
            "required": [
              "device_path"
            ],
            "type": "object",
            "x-oscal-subid": "sch.service.identity-sled.btrfs-device.schema@v1"
          },
          "TpmDevice": {
            "properties": {
              "path": {
                "description": "Container TPM device path, e.g. `/dev/tpm0` (unused for VMs).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "pathrm": {
                "description": "Container resource-manager path, e.g. `/dev/tpmrm0` (unused for VMs).",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "UnixDevice": {
            "description": "Shared by `unix-char` and `unix-block` (identical key set).",
            "properties": {
              "gid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "major": {
                "format": "int64",
                "type": [
