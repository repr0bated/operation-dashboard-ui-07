          "PciDevice": {
            "properties": {
              "address": {
                "description": "Required. PCI address of the device, e.g. `0000:00:1f.0`.",
                "type": "string"
              },
              "firmware": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
