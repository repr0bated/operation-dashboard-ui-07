                "type": [
                  "integer",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "network": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nictype": {
                "description": "Sub-type when not using a managed network: bridged, macvlan, sriov,\nphysical, ipvlan, p2p, routed.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pci": {
