    "get_session_history": {
      "args": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "default": 0,
            "description": "Maximum entries to return, newest first (0 = all).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "GetSessionHistoryInput",
        "type": "object"
      },
      "idempotent": true,
      "name": "get_session_history",
      "required_capability": "identity_sled.read",
      "returns": {
        "$defs": {
          "SessionEvent": {
            "description": "One entry in a session's append-only \"snowball\" ledger.",
            "properties": {
              "content": {
                "default": "",
                "description": "JSON payload of the event.",
                "type": "string"
              },
              "created_at": {
                "description": "Unix seconds the event was recorded.",
                "format": "int64",
                "type": "integer"
              },
              "kind": {
                "description": "Event kind (e.g. \"arrival\", \"mutation\", \"handshake\").",
                "type": "string"
              },
              "seq": {
                "description": "Monotonic sequence within the session.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "session_id": {
                "description": "Session the event belongs to.",
                "type": "string"
              },
              "subid": {
                "default": "",
                "description": "OSCAL subid of the acting surface, when applicable.",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "seq",
              "kind",
              "created_at"
            ],
            "type": "object",
            "x-oscal-subid": "sch.service.identity-sled.session-event.schema@v1"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/$defs/SessionEvent"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "GetSessionHistoryOutput",
        "type": "object"
      },
      "side_effect": "read",
      "subid": "obs.service.identity-sled.session.history.get@v1"
    },
    "provision_container": {
      "args": {
        "$defs": {
          "Device": {
            "description": "A single Incus device, tagged by its `type` key.\n\nOne variant per official Incus device type. `nic`, `gpu` and `infiniband`\ncarry their sub-type selector (`nictype`/`gputype`) as a field rather than a\nnested union, matching the flat `map[string]string` the API uses.",
            "oneOf": [
              {
                "$ref": "#/$defs/NicDevice",
                "description": "Network interface. `nictype` (or a managed `network`) selects the kind.",
                "properties": {
                  "type": {
                    "const": "nic",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/DiskDevice",
                "description": "Disk / filesystem / block volume mount.",
                "properties": {
                  "type": {
                    "const": "disk",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixDevice",
                "description": "Unix character device passthrough (containers only).",
                "properties": {
                  "type": {
                    "const": "unix-char",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixDevice",
                "description": "Unix block device passthrough (containers only).",
                "properties": {
                  "type": {
                    "const": "unix-block",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UsbDevice",
                "description": "USB device passthrough.",
                "properties": {
                  "type": {
                    "const": "usb",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/GpuDevice",
                "description": "GPU passthrough. `gputype` selects physical/mdev/mig/sriov.",
                "properties": {
                  "type": {
                    "const": "gpu",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/InfinibandDevice",
                "description": "InfiniBand device. `nictype` selects physical/sriov.",
                "properties": {
                  "type": {
                    "const": "infiniband",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/ProxyDevice",
                "description": "Proxy device (port/socket forwarding between host and instance).",
                "properties": {
                  "type": {
                    "const": "proxy",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/UnixHotplugDevice",
                "description": "Hot-pluggable Unix device matched by vendor/product id.",
                "properties": {
                  "type": {
                    "const": "unix-hotplug",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/TpmDevice",
                "description": "Trusted Platform Module.",
                "properties": {
                  "type": {
                    "const": "tpm",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/PciDevice",
                "description": "Raw PCI passthrough (VMs only).",
                "properties": {
                  "type": {
                    "const": "pci",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Sentinel that removes an inherited device of the same name. No keys.",
                "properties": {
                  "type": {
                    "const": "none",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "DiskDevice": {
            "properties": {
              "boot.priority": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ceph.cluster_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ceph.user_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "io.bus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "io.cache": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.max": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.read": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limits.write": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "propagation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "raw.mount.options": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "readonly": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "recursive": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "shift": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "size": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size.state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wwn": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "GpuDevice": {
            "properties": {
              "gid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "gputype": {
                "description": "Sub-type: physical (default), mdev, mig, sriov.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mdev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mig.ci": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "mig.gi": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "mig.uuid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pci": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "productid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "vendorid": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "IncusInstance": {
            "description": "A single Incus instance, modeled on the official Incus API (`shared/api`\n`Instance`/`InstancePut`).\n\nDevices (including proxy sockets) are the typed [`NamedDevice`] union — Incus\nhas no first-class \"socket\" concept, a proxy is simply a `devices` entry with\n`type: proxy`. The previous non-standard `sockets`/`IncusProxySocket` field is\ngone; a container's relationship to the shared `container.sock` is resolved\nby name at the projection/gemma layer, not embedded here.",
            "properties": {
              "architecture": {
                "description": "CPU architecture (e.g. \"x86_64\")",
                "type": [
                  "string",
                  "null"
                ]
              },
              "config": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Instance configuration key-value pairs (`InstancePut.config`).",
                "type": [
                  "object",
                  "null"
                ]
              },
              "created_at": {
                "description": "Creation timestamp (ISO8601)",
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "description": "Human-readable description",
                "type": [
                  "string",
                  "null"
                ]
              },
              "devices": {
                "description": "Typed device definitions (`InstancePut.devices`). Proxy sockets, NICs,\ndisks, GPUs, etc. are all variants of [`Device`].",
                "items": {
                  "$ref": "#/$defs/NamedDevice"
                },
                "type": "array"
              },
              "ephemeral": {
                "description": "Delete instance on shutdown",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "expanded_config": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Expanded (profile-merged) config, read-only (`Instance.expanded_config`).",
                "type": [
                  "object",
                  "null"
                ]
              },
              "expanded_devices": {
                "description": "Expanded (profile-merged) devices, read-only (`Instance.expanded_devices`).",
                "items": {
                  "$ref": "#/$defs/NamedDevice"
                },
                "type": "array"
              },
              "image": {
                "description": "Source image reference, used only at creation time (`incus init <image>`).\nNot part of the official `InstancePut`; derived from config on read.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_used_at": {
                "description": "Last start timestamp (ISO8601)",
                "type": [
                  "string",
                  "null"
                ]
              },
              "location": {
                "description": "Cluster member location (\"none\" on single-node)",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "profiles": {
                "default": [],
                "description": "Applied profiles (e.g. [\"default\"])",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "project": {
                "description": "Incus project name",
                "type": [
                  "string",
                  "null"
                ]
              },
              "stateful": {
                "description": "Whether saved state exists on disk",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "description": "Instance status: \"Running\", \"Stopped\", \"Frozen\"",
                "type": "string"
              },
              "status_code": {
                "description": "Numeric status code from the Incus API (read-only).",
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "storage_pool": {
                "description": "Preferred storage pool used during initial creation (creation hint only).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "description": "Instance type: \"container\" or \"virtual-machine\"",
                "type": "string"
              }
            },
            "required": [
              "name",
              "status",
              "type"
            ],
            "type": "object"
          },
          "InfinibandDevice": {
            "properties": {
              "hwaddr": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mtu": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nictype": {
                "description": "Sub-type: physical or sriov.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "NamedDevice": {
            "description": "A device paired with its Incus device name (the map key).\n\nRenders as an object `{ name, device: oneOf<…> }`; the `device` union is the\nschema-visible discriminated type. The REST layer flattens a `Vec` of these\ninto Incus's `map[name] -> { type, … }` and back.",
            "properties": {
              "device": {
                "$ref": "#/$defs/Device",
                "description": "The typed device definition."
              },
              "name": {
                "description": "Incus device name (the map key, e.g. `\"eth0\"`, `\"grpc-socket\"`).",
                "type": "string"
              }
            },
            "required": [
              "name",
              "device"
            ],
            "type": "object"
          },
          "NicDevice": {
            "properties": {
              "acceleration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "boot.priority": {
                "format": "int64",
