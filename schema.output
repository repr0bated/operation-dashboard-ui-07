                ]
              }
            },
            "type": "object"
          },
          "UnixHotplugDevice": {
            "properties": {
              "gid": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pci": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "productid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required": {
