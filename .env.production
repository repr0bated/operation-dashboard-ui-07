# Served via non-oracle ingress → xray → op-web :8080
VITE_API_BASE_URL="/api"
# gRPC-Web demuxed by SNI: assistant-grpc.ghostbridge.tech → op-grpc-bridge
# :8090. assistant.3tched.com serves the dashboard page (op-web:8080), so
# gRPC must not point there. (assistant-grpc.3tched.com has no DNS A record.)
VITE_GRPC_BASE_URL="https://assistant-grpc.ghostbridge.tech"
VITE_GHOSTBRIDGE_FOOTPRINT=""
VITE_GHOSTBRIDGE_TRACE_ID=""
