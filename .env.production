# Dashboard and gRPC served directly on the WireGuard mesh (L3 encrypted).
# No TLS needed — avoids xray XHTTP reframing that kills gRPC server streams.
VITE_API_BASE_URL="/api"
# Intentionally unset: op-web now reverse-proxies gRPC-Web service paths
# (see crates/op-web/src/grpc_proxy.rs) to loopback-only op-grpc-bridge.
# Leaving this empty makes resolveGrpcBaseUrl() in src/grpc/client.ts fall
# through to window.location.origin — same-origin, whatever host/interface
# the page was actually loaded from (localhost, svc0/NetMaker, or the
# public domain). No hardcoded upstream host baked into the build.
VITE_GRPC_BASE_URL=
# Intentionally unset: a hardcoded footprint/trace-id goes stale on every
# blob reseal (footprint is tied to the schema catalog hash). Leaving these
# empty makes src/lib/identity.ts fall through to fromSled(), which reads
# /api/identity/sled live on every page load — always current, self-healing,
# no re-deploy needed after a reseal.
VITE_GHOSTBRIDGE_FOOTPRINT=
VITE_GHOSTBRIDGE_TRACE_ID=
