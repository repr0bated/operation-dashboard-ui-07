// Example Zerolang Agents that work with Kiro specs via plugin system
// These agents query, validate, and patch Kiro-generated specs without modifying infrastructure

pub package KiroAgentExamples {
  use KiroAgentLoop.*

  // ── Example 1: UI Spec Generator Agent ─────────────────────────────

  pub fn ui_spec_generator_agent(
    context: String,
    data_shape: String,
    signal_to_convey: String,
    action_to_afford: String
  ) -> Result<KiroSpec, Error> raises {
    // Agent asks: "What specs do Kiro have for similar UIs?"
    let similar_specs = query_kiro_specs()
    let catalog_specs = similar_specs.specs
      .filter_by_context_similarity(context)

    // Agent queries existing patterns
    for spec in catalog_specs {
      let result = agent_query(AgentQueryRequest {
        spec_id: spec.id,
        query_path: "/structure/patterns",
        filter: FilterCondition {
          matches_signal: signal_to_convey
        }
      })?

      // Agent learns constraints from Kiro schema
      let constraints = spec.schema.constraints
    }

    // Agent patches: add new UI spec node
    let new_spec_patch = AgentPatchRequest {
      spec_id: "gallery-ui-" + timestamp(),
      patches: vec![
        SpecPatch {
          op: Add,
          path: "/nodes/-",
          value: json({
            kind: "stack",
            axis: "col",
            signal: signal_to_convey,
            action: action_to_afford
          })
        }
      ],
      reason: format!("UI spec for: {}", context)
    }

    agent_patch(new_spec_patch)
  }

  // ── Example 2: Spec Validator Agent ───────────────────────────────

  pub fn spec_validator_agent(spec_id: String) -> Result<ValidatorReport, Error> raises {
    let spec = query_spec_by_id(spec_id)?

    // Validate against Kiro schema
    validate_kiro_spec(spec)?

    // Agent checks constraints
    let mut report = ValidatorReport {
      spec_id: spec_id,
      is_valid: true,
      issues: vec![],
      audit_trail: now_ms()
    }

    for constraint in spec.schema.constraints {
      let violation = check_constraint(&spec, &constraint)
      if let Some(v) = violation {
        report.is_valid = false
        report.issues.push(v)
      }
    }

    report
  }

  // ── Example 3: Batch Spec Patcher Agent ────────────────────────────

  pub fn batch_patcher_agent(
    specs_to_update: Vec<String>,
    update_reason: String
  ) -> Result<BatchPatchReport, Error> raises {
    let mut patch_requests = Vec::new()

    // Agent queries each spec
    for spec_id in specs_to_update {
      let spec = query_spec_by_id(spec_id)?

      // Agent analyzes spec structure
      let node_count = count_spec_nodes(&spec)
      check node_count <= 200 : "Spec exceeds 200-node limit"

      // Agent builds patches
      let patches = vec![
        SpecPatch {
          op: Replace,
          path: "/metadata/last_reviewed",
          value: now_ms()
        },
        SpecPatch {
          op: Replace,
          path: "/metadata/reviewer",
          value: current_agent_id()
        }
      ]

      patch_requests.push(AgentPatchRequest {
        spec_id: spec_id,
        patches: patches,
        reason: update_reason.clone()
      })
    }

    // Coordinate patches through plugin system
    let batch_result = coordinate_agents(patch_requests)?

    BatchPatchReport {
      total_specs: specs_to_update.len(),
      successful: batch_result.successful,
      failed: batch_result.total_patches - batch_result.successful,
      audit_entries: batch_result.results.map(|r| r.audit_trace)
    }
  }

  // ── Example 4: Constraint Repair Agent ─────────────────────────────

  pub fn constraint_repair_agent(spec_id: String) -> Result<RepairReport, Error> raises {
    let spec = query_spec_by_id(spec_id)?

    // Agent queries constraint definitions
    let constraints = spec.schema.constraints

    // Agent finds violations
    let mut violations = Vec::new()
    for constraint in constraints {
      if let Some(v) = check_constraint(&spec, &constraint) {
        violations.push(v)
      }
    }

    check !violations.is_empty() : "No constraint violations found"

    // Agent builds repair patches
    let mut repair_patches = Vec::new()

    for violation in violations {
      match violation.constraint_type {
        MaxNodeCount => {
          // Agent removes least-critical nodes
          repair_patches.push(SpecPatch {
            op: Remove,
            path: violation.problematic_path,
            value: null
          })
        },
        NoForbiddenNames => {
          // Agent replaces forbidden names
          repair_patches.push(SpecPatch {
            op: Replace,
            path: violation.problematic_path,
            value: sanitize_forbidden_name(violation.value)
          })
        }
      }
    }

    // Agent submits repairs
    let repair_result = agent_patch(AgentPatchRequest {
      spec_id: spec_id,
      patches: repair_patches,
      reason: "Automatic constraint repair via Zerolang agent"
    })?

    RepairReport {
      spec_id: spec_id,
      violations_found: violations.len(),
      violations_repaired: repair_patches.len(),
      new_version: repair_result.new_version,
      audit_trace: repair_result.audit_trace
    }
  }

  // ── Types ──────────────────────────────────────────────────────────

  pub struct ValidatorReport {
    spec_id: String,
    is_valid: bool,
    issues: Vec<ValidationIssue>,
    audit_trail: u64
  }

  pub struct ValidationIssue {
    constraint: String,
    severity: IssueSeverity,
    message: String
  }

  pub enum IssueSeverity {
    Info,
    Warning,
    Error,
    Critical
  }

  pub struct BatchPatchReport {
    total_specs: u32,
    successful: u32,
    failed: u32,
    audit_entries: Vec<AuditEntry>
  }

  pub struct RepairReport {
    spec_id: String,
    violations_found: u32,
    violations_repaired: u32,
    new_version: u64,
    audit_trace: AuditEntry
  }

  pub struct FilterCondition {
    matches_signal: String
  }

  // ── Agent Helpers ──────────────────────────────────────────────────

  fn check_constraint(spec: &KiroSpec, constraint: &Constraint) -> Option<ConstraintViolation> raises
  fn count_spec_nodes(spec: &KiroSpec) -> u32 raises
  fn sanitize_forbidden_name(name: String) -> String raises
  fn timestamp() -> String raises
}
